<Window x:Class="Titanium.CommandDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CollabHub Command Deck"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DeckBackground}">
    <Grid Background="{StaticResource DeckBackground}">
        <wv2:WebView2 x:Name="DeckWebView" />
        <Border x:Name="StatusOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Padding="28"
                Background="#ED0A111C"
                BorderBrush="#552CE6E6"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Text="COLLABHUB COMMAND DECK"
                           Foreground="{StaticResource DeckCyan}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Margin="0,16,0,0"
                           Text="Initialisation sécurisée…"
                           Foreground="#E9F7FA"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
