# =============================================================================
# TITANIUM v12 — Exemple de configuration
# Copie ce fichier en .env et remplis tes vraies valeurs
# =============================================================================

# --- Binance ---
BINANCE_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# --- Symboles ---
BINANCE_SYMBOLS=BTC/USDT,PAXG/USDT
SCAN_INTERVAL=5

# --- Telegram (optionnel) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_IDS=your_chat_id
TELEGRAM_MIN_INTERVAL_SEC=300
TELEGRAM_SCORE_THRESHOLD=7

# --- Twelve Data (Gold/PAXG) ---
TWELVEDATA_API_KEY=your_twelvedata_key

# --- Fundamentals (module macro) ---
FUNDAMENTALS_ENABLED=1
FUNDAMENTALS_REFRESH_SEC=900
FUNDAMENTALS_RISK_BLOCK=70
FUNDAMENTALS_RISK_REDUCE=30
NEWSAPI_KEY=your_newsapi_key_optional
GDELT_ENABLED=1

# --- Ollama Vision ---
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL_PRIMARY=llava
VISION_TEXT_ONLY=1

# --- Serveur ---
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
LOG_LEVEL=INFO

# --- Risk ---
CAPITAL_EUR=300
RISK_PCT=0.02
