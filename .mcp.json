{
  "mcpServers": {
    "base44": {
      "command": "venv\\Scripts\\python.exe",
      "args": ["mcp_base44.py"]
    },
    "titanium": {
      "command": "venv\\Scripts\\python.exe",
      "args": ["mcp_server.py"]
    },
    "titanium_structural": {
      "command": ".pyembed\\python.exe",
      "args": ["tools\\structural_mcp.py"],
      "env": {
        "TITANIUM_STRUCTURE_ROOT": "."
      }
    },
    "hermes": {
      "command": "${LOCALAPPDATA}\\hermes\\hermes-agent\\venv\\Scripts\\hermes.exe",
      "args": ["mcp", "serve"]
    },
    "gitnexus_write_gate": {
      "command": "gitnexus\\gate-venv\\Scripts\\python.exe",
      "args": ["mcp_gitnexus_gate.py"]
    }
  }
}
